# Copy to `.env` (gitignored) and fill in real values. Nothing here is
# required for `pnpm dev` to boot — the contact form falls back to mailto
# when the EmailJS keys are absent, and Sentry is optional.

# --- Contact form (EmailJS) ---------------------------------------------
# Required only for the EmailJS channel. Grab these from your EmailJS
# dashboard (Account → API Keys, and your Service/Email Template IDs).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# --- Search engine ownership verification (optional) --------------------
# Google Search Console: add property → paste the google-site-verification
# token from the HTML-tag method here. Bing Webmaster Tools: same flow, the
# msvalidate.01 token. When set, the build injects the matching <meta> tags
# into index.html; when unset, no tags ship.
VITE_GSC_TOKEN=
VITE_BING_TOKEN=

# --- Error tracking (Sentry, optional) ----------------------------------
# Runtime DSN consumed by @sentry/react. Set in the Vercel dashboard for
# production; local dev can leave it blank.
VITE_SENTRY_DSN=

# Build-time Sentry vars (consumed by @sentry/vite-plugin during `pnpm
# build` only — optional, and never needed locally):
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
