{
  "name": "foces_official",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "vite",
    "dev:network": "vite --host",
    "check": "pnpm lint && pnpm format:check && pnpm test:unit",
    "verify": "pnpm check && pnpm check:specs && pnpm check:assets && pnpm check:sw && pnpm build && git diff --check",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives",
    "lint:watch": "eslint . --ext js,jsx --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:install": "playwright install chromium",
    "knip": "knip",
    "lint:workflows": "node scripts/maintenance/actionlint-check.mjs",
    "check:assets": "node scripts/maintenance/check-orphan-assets.mjs",
    "check:sw": "node scripts/maintenance/check-sw-precache.mjs",
    "check:specs": "node scripts/maintenance/check-specs.mjs",
    "probe:carousel": "node scripts/probes/carousel-probe.mjs",
    "probe:mobile": "node scripts/probes/mobile-probe.mjs",
    "probe:wcag": "node scripts/probes/wcag-probe.mjs",
    "probe:img": "node scripts/probes/img-probe.mjs",
    "probe:firefox": "node scripts/probes/firefox-probe.mjs",
    "probe:perf": "node scripts/probes/perf-test.mjs",
    "probe:perf:quick": "node scripts/probes/perf-probe.mjs",
    "probe:boot": "node scripts/probes/boot-profile.mjs",
    "clean": "rm -rf dist test-results playwright-report",
    "prepare": "husky"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@sentry/react": "^10.70.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "aos": "^2.3.4",
    "js.foresight": "^4.2.1",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router": "8.3.0",
    "react-toastify": "^11.1.0",
    "three": "^0.185.1",
    "vanta": "^0.5.24",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.10.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "lighthouse": "^13.4.1",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.6.0",
    "sharp": "^0.35.3",
    "svgo": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1",
    "vite-imagetools": "^12.0.0",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
