# EditorConfig — consistent formatting for every contributor and editor.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# CSS files in this repo use 4-space indentation (see src/**/*.css).
[*.css]
indent_size = 4

# Markdown keeps intentional trailing whitespace (hard line breaks).
[*.md]
trim_trailing_whitespace = false
