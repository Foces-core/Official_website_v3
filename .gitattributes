# Normalize line endings so contributors on Windows/Linux/macOS don't cause
# whitespace churn in every diff. Pairs with .editorconfig.
* text=auto

# Source files: always LF in the repo and on checkout.
*.js    text eol=lf
*.jsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.cjs   text eol=lf
*.mjs   text eol=lf

# Lockfiles and images: never treat as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.avif binary
*.svg  text eol=lf
*.woff2 binary
